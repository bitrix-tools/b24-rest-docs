          "name": "docType",
          "type": "char",
          "base": "char",
          "required": true,
          "description": "Тип документа. Возможные значения: - A — поступление, - S — оприходование, - M — перемещение между складами, - R — возврат, - D — списание. Актуальные типы документов можно получить методом catalog.enum.getStoreDocumentTypes"
        },
        {
          "name": "currency",
          "type": "crm_currency.CURRENCY",
          "base": "any",
          "required": true,
          "description": "Валюта документа в формате ISO 4217, например RUB. Значение нельзя изменить после создания. Чтобы получить список валют с кодами используйте метод crm.currency.list"
        },
        {
          "name": "responsibleId",
