          "type": "char",
          "base": "char",
          "required": false,
          "description": "Код сайта, к которому относится документ. По умолчанию — s1. Параметр актуален для коробочных Битрикс, для облачных Битрикс значение стандратное — s1"
        },
        {
          "name": "dateDocument",
          "type": "datetime",
          "base": "datetime",
          "required": false,
          "description": "Дата проведения документа в формате ISO 8601"
        },
