  "params": [
    {
      "name": "POST_ID",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Фильтрация по идентификатору сообщения. Идентификатор указан в поле ID элемента результата метода. Если параметр передан, фильтрация по LOG_RIGHTS игнорируется"
    },
    {
      "name": "LOG_RIGHTS",
      "type": "array",
      "base": "array",
      "required": false,
      "description": "Фильтрация по получателям, у которых есть право на просмотр сообщения. Возможные значения: - SG<X> — рабочие группы и проекты с идентификатором X. Идентификатор можно получить методом sonetgroup.get - U<X> — пользователи с идентификатором X. Идентификатор можно получить методом user.get - UA — все авторизованные пользователи - DR<X> — подразделения компании с идентификатором X.…",
      "dynamic": {
        "allowed": true,
        "note": "Состав полей не описан подтаблицей на этой странице"
      }
    },
    {
      "name": "LOG_DATE_FROM",
      "type": "string",
      "base": "string",
      "required": false,
      "description": "Нижняя граница периода публикации сообщения в формате ISO 8601. Если указаны LOG_DATE_FROM и LOG_DATE_TO, значение LOG_DATE_FROM не должно быть позже LOG_DATE_TO. Пустая строка не ограничивает выборку"
    },
    {
      "name": "LOG_DATE_TO",
      "type": "string",
      "base": "string",
      "required": false,
      "description": "Верхняя граница периода публикации сообщения в формате ISO 8601. Если значение не указано или передана пустая строка, верхняя граница периода не применяется"
    },
    {
      "name": "FIRST_ID",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Идентификатор записи Ленты новостей для курсорной навигации вперед. Метод вернет сообщения с идентификаторами больше указанного значения. Если переданы FIRST_ID и LAST_ID, применяется FIRST_ID. Значение 0 или пустая строка начинает выборку с края списка"
    },
    {
      "name": "LAST_ID",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Идентификатор записи Ленты новостей для курсорной навигации назад. Метод вернет сообщения с идентификаторами меньше указанного значения. Значение 0 или пустая строка начинает выборку с края списка"
    },
    {
      "name": "LIMIT",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Размер страницы в курсорном режиме. По умолчанию — 50. Неположительное или нечисловое значение заменяется значением по умолчанию. Максимальное значение — 200"
    },
    {
      "name": "start",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Параметр используется для управления постраничной навигацией. Размер страницы результатов всегда статичный — 50 записей. Чтобы выбрать вторую страницу результатов, необходимо передавать значение 50. Чтобы выбрать третью страницу результатов — значение 100 и так далее. Формула расчета значения параметра start: start = (N - 1) * 50, где N — номер нужной страницы"
    }
  ],
