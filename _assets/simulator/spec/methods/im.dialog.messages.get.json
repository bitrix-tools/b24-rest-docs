{
  "$v": 1,
  "method": "im.dialog.messages.get",
  "scope": "im",
  "kind": "read",
  "title": "Получить список последних сообщений im.dialog.messages.get",
  "permissions": "участник чата",
  "params": [
    {
      "name": "DIALOG_ID",
      "type": "string",
      "base": "string",
      "required": true,
      "description": "Идентификатор чата в формате: - chatXXX — чат - sgXXX — чат группы или проекта - XXX — идентификатор пользователя личного чата Идентификатор чата можно получить с помощью метода im.chat.get. Идентификатор пользователя — с помощью методов user.get и user.search"
    },
    {
      "name": "LAST_ID",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Идентификатор сообщения, относительно которого нужно загрузить более старые сообщения. Метод вернет сообщения с идентификатором меньше указанного. Чтобы последовательно загрузить историю назад, сначала запросите последние сообщения без LAST_ID и FIRST_ID. Затем передайте в LAST_ID минимальный id из полученного массива messages"
    },
    {
      "name": "FIRST_ID",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Идентификатор сообщения, относительно которого нужно загрузить более новые сообщения. Метод вернет сообщения с идентификатором больше указанного. Например, при FIRST_ID=123 и LIMIT=10 метод вернет до 10 сообщений с идентификатором больше 123. Чтобы получить сообщения, добавленные после уже загруженной выборки, передайте в FIRST_ID максимальный id из полученного массива messages"
    },
    {
      "name": "LIMIT",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Ограничение на количество сообщений в ответе. Если не переданы LAST_ID и FIRST_ID — метод вернет последние сообщения диалога с учетом LIMIT. Метод может вернуть больше сообщений, чем указано в LIMIT, если в чате есть непрочитанные сообщения. По умолчанию — 20. Максимальное значение — 50"
    }
  ],
