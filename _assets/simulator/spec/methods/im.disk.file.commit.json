  "params": [
    {
      "name": "CHAT_ID",
      "type": "integer",
      "base": "integer",
      "required": true,
      "description": "Идентификатор чата. Обязателен, если не передан DIALOG_ID"
    },
    {
      "name": "DIALOG_ID",
      "type": "string",
      "base": "string",
      "required": true,
      "description": "Идентификатор диалога в формате: - chatXXX — чат - sgXXX — чат группы или проекта - XXX — идентификатор пользователя личного чата Обязателен, если не передан CHAT_ID"
    },
    {
      "name": "FILE_ID",
      "type": "integer",
      "base": "integer",
      "required": true,
      "description": "Идентификатор файла на Диске. Можно передать массив. Обязателен, если не передан UPLOAD_ID"
    },
    {
      "name": "UPLOAD_ID",
      "type": "integer",
      "base": "integer",
      "required": true,
      "description": "Идентификатор файла на Диске. Можно передать массив. Поддерживает дополнительный параметр AS_FILE, который позволяет отправить изображение без сжатия, в виде файла. Обязателен, если не передан FILE_ID"
    },
    {
      "name": "MESSAGE",
      "type": "string",
      "base": "string",
      "required": false,
      "description": "Текст сообщения с файлом"
    },
    {
      "name": "SILENT_MODE",
      "type": "string",
      "base": "string",
      "required": false,
      "description": "Параметр для чата Открытых линий Возможные значения: - Y — отправлять уведомление клиенту - N — не отправлять уведомление клиенту"
    },
    {
      "name": "AS_FILE",
      "type": "string",
      "base": "string",
      "required": false,
      "description": "Отправить как файл. Только для UPLOAD_ID. Возможные значения: - Y — да - N — нет"
    }
  ],
