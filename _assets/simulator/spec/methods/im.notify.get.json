{
  "$v": 1,
  "method": "im.notify.get",
  "scope": "im",
  "kind": "read",
  "title": "Получить уведомления im.notify.get",
  "permissions": "любой пользователь",
  "params": [
    {
      "name": "LAST_ID",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Идентификатор последнего уведомления предыдущей страницы для загрузки следующей. Обычно берется из поля id последнего элемента массива notifications в ответе предыдущего шага выборки или в ответе im.notify.history.search Идентификатор уведомления также возвращают методы im.notify, im.notify.personal.add и im.notify.system.add. Параметр нужно использовать вместе с LAST_TYPE"
    },
    {
      "name": "LAST_TYPE",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Технический курсор пагинации. Допустимые значения: - 1 — продолжить выборку с этапа подтверждений - 3 — продолжить выборку с этапа обычных уведомлений Параметр нужно использовать вместе с LAST_ID. Для значений, отличных от 1 и 3, сервер не возвращает отдельную ошибку"
    },
    {
      "name": "LIMIT",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Количество уведомлений на страницу. Значение по умолчанию — 50. Максимальное значение — 50"
    },
    {
      "name": "CONVERT_TEXT",
      "type": "string",
      "base": "string",
      "required": false,
      "description": "Преобразовать текст уведомлений. Значение Y включает преобразование, любое другое значение отключает"
    }
  ],
