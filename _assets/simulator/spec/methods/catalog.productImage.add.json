      "fields": [
        {
          "name": "productId",
          "type": "catalog_product.id",
          "base": "any",
          "required": true,
          "description": "Идентификатор товара, головного товара, вариации или услуги. Чтобы получить существующие идентификаторы, используйте следующие методы: - для товаров — catalog.product.list - для головных товаров — catalog.product.sku.list - для вариаций товара — catalog.product.offer.list - для услуг — catalog.product.service.list"
        },
        {
          "name": "type",
          "type": "string",
          "base": "string",
          "required": false,
          "description": "Тип изображения: - DETAIL_PICTURE — детальная картинка, поле доступно в старой карточке товара - PREVIEW_PICTURE — картинка для анонса, поле доступно в старой карточке товара - MORE_PHOTO — картинка Если не указать значение, то картинка будет сохранена в MORE_PHOTO"
        }
      ]
    }
  },
  "requiredConvention": true,
  "confidence": "parsed",
