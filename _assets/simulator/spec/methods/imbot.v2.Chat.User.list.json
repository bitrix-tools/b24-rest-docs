{
  "$v": 1,
  "method": "imbot.v2.Chat.User.list",
  "scope": "imbot",
  "kind": "read",
  "title": "Получить список участников чата imbot.v2.Chat.User.list",
  "permissions": "владелец зарегистрированного бота",
  "params": [
    {
      "name": "botId",
      "type": "integer",
      "base": "integer",
      "required": true,
      "description": "ID бота"
    },
    {
      "name": "botToken",
      "type": "string",
      "base": "string",
      "required": false,
      "description": "Токен бота. Обязателен при авторизации через вебхук, для OAuth не нужен. Передавайте тот же botToken, который указали при регистрации бота"
    },
    {
      "name": "dialogId",
      "type": "string",
      "base": "string",
      "required": true,
      "description": "ID группового чата в формате dialogId: chat{chatId}"
    },
    {
      "name": "order",
      "type": "object",
      "base": "object",
      "required": false,
      "description": "Сортировка. Доступные поля: - id — порядок вступления в чат - lastSendMessageId — ID последнего сообщения участника - userId — ID пользователя Направление сортировки: ASC или DESC. Если передать несколько полей, метод учтет одно — то, что стоит выше в списке доступных полей. Без order порядок не гарантирован. Пример: {\"id\": \"ASC\"}",
      "dynamic": {
        "allowed": true,
        "note": "Состав полей не описан подтаблицей на этой странице"
      }
    },
    {
      "name": "limit",
      "type": "integer",
      "base": "integer",
      "required": false,
      "description": "Количество записей, от 1 до 200. По умолчанию 50. Значение вне диапазона не вызывает ошибку — метод вернет до 50 записей"
    }
  ],
